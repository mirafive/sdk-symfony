includes:
    - vendor/phpstan/phpstan-symfony/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon

parameters:
    level: max
    phpVersion:
        min: 80300
        max: 80599
    paths:
        - src
    # Public input is checked at runtime even where the PHPDoc already promises its shape.
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Used by applications' tests, not inside src.
        - identifier: trait.unused
          path: src/Test/InteractsWithMira.php
