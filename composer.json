{
    "name": "mirafive/sdk-symfony",
    "description": "Symfony bundle for MIRA FIVE, privacy-first analytics: server-side events, feature flags and the tracker tag.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": ["analytics", "privacy", "gdpr", "feature-flags", "experiments", "symfony", "bundle", "mirafive"],
    "homepage": "https://mirafive.io",
    "authors": [
        {
            "name": "Cloo GmbH",
            "homepage": "https://mirafive.io"
        }
    ],
    "require": {
        "php": "^8.3",
        "mirafive/sdk-php": "^1.0",
        "psr/log": "^1.1|^2.0|^3.0",
        "psr/simple-cache": "^2.0|^3.0",
        "symfony/cache": "^6.4|^7.0|^8.0",
        "symfony/config": "^6.4|^7.0|^8.0",
        "symfony/console": "^6.4|^7.0|^8.0",
        "symfony/dependency-injection": "^6.4|^7.0|^8.0",
        "symfony/event-dispatcher": "^6.4|^7.0|^8.0",
        "symfony/framework-bundle": "^6.4|^7.0|^8.0",
        "symfony/http-foundation": "^6.4|^7.0|^8.0",
        "symfony/http-kernel": "^6.4|^7.0|^8.0",
        "symfony/service-contracts": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5|^12.0",
        "symfony/messenger": "^6.4|^7.0|^8.0",
        "symfony/twig-bundle": "^6.4|^7.0|^8.0",
        "twig/twig": "^3.10"
    },
    "suggest": {
        "symfony/twig-bundle": "For the mirafive_script() and mirafive_flags() Twig functions.",
        "symfony/messenger": "To hand batches to a Messenger transport instead of sending them in the request."
    },
    "conflict": {
        "twig/twig": "<3.10"
    },
    "autoload": {
        "psr-4": {
            "MiraFive\\Symfony\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiraFive\\Symfony\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": "phpunit",
        "check": [
            "pint --test",
            "phpstan analyse --memory-limit=1G --no-progress",
            "phpunit"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
