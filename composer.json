{
  "name": "mirafive/sdk-symfony",
  "description": "MIRA FIVE for Symfony: server events, revenue and touchpoints, the browser script tag, Messenger and test helpers",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "analytics",
    "attribution",
    "revenue",
    "gdpr",
    "consent",
    "symfony",
    "bundle",
    "mirafive"
  ],
  "homepage": "https://mirafive.io",
  "support": {
    "issues": "https://github.com/mirafive/sdk-symfony/issues",
    "source": "https://github.com/mirafive/sdk-symfony"
  },
  "authors": [
    {
      "name": "Cloo GmbH",
      "homepage": "https://mirafive.io"
    }
  ],
  "require": {
    "php": "^8.3",
    "mirafive/sdk-php": "^2.1",
    "psr/log": "^2.0 || ^3.0",
    "psr/simple-cache": "^2.0 || ^3.0",
    "symfony/config": "^7.4 || ^8.0",
    "symfony/console": "^7.4 || ^8.0",
    "symfony/dependency-injection": "^7.4 || ^8.0",
    "symfony/event-dispatcher": "^7.4 || ^8.0",
    "symfony/http-kernel": "^7.4 || ^8.0",
    "symfony/service-contracts": "^3.5"
  },
  "require-dev": {
    "laravel/pint": "^1.32",
    "pestphp/pest": "^4.7 || ^5.3",
    "phpstan/phpstan": "^2.3",
    "phpstan/phpstan-strict-rules": "^2.1",
    "phpstan/phpstan-symfony": "^2.1",
    "symfony/cache": "^7.4 || ^8.0",
    "symfony/framework-bundle": "^7.4 || ^8.0",
    "symfony/messenger": "^7.4 || ^8.0",
    "symfony/twig-bundle": "^7.4 || ^8.0",
    "twig/twig": "^3.21"
  },
  "suggest": {
    "symfony/cache": "Shares the delivery breaker between PHP processes (the default cache.app pool).",
    "symfony/messenger": "Hands batches to a Messenger transport instead of sending them after the response.",
    "symfony/twig-bundle": "For the mirafive_script() Twig function."
  },
  "conflict": {
    "twig/twig": "<3.21"
  },
  "autoload": {
    "psr-4": {
      "MiraFive\\Symfony\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MiraFive\\Symfony\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "pint",
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "pest",
    "check": [
      "pint --test",
      "phpstan analyse --memory-limit=1G --no-progress",
      "pest"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
